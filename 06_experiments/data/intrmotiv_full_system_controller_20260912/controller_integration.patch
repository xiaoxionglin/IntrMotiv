+    delta=preservation_delta(parent,dict(parent,seed=8),approved_factors={'seed':'New learner seed; source seed remains 99 in parent manifest'})
+    assert delta[0]['classification']=='explicit_experimental_factor'
+    with pytest.raises(ValueError,match='gamma'):
+        preservation_delta(parent,{'seed':99})
