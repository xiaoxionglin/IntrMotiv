+def test_goal_write_her_rebuilds_worker_history_with_each_network_parameters():
+    cfg = SimpleNamespace(Hippo_R=2,Hippo_L=3,Hippo_n_feature=3,hrl_controllable_graph=True,
+        hrl_graph_memory='policy_buffer',hrl_target_timing='immediate',hrl_manager_mode='frontier_direct',
+        dg_context_feedback='none',dg_orthogonal_recruitment=False,DG_BN_intercept=1.)
