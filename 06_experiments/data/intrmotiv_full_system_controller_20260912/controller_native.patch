+    else:old_c,new_c,exp_c=old_state,rebuilt,expected
+    torch.testing.assert_close(new_c[:,:model.core.base_state_size],exp_c[:,:model.core.base_state_size])
+    torch.testing.assert_close(new_c[:,model.core.base_state_size:],old_c[:,model.core.base_state_size:],rtol=0,atol=0)
+    for k,v in model.state_dict().items():torch.testing.assert_close(v,before[k],rtol=0,atol=0)
