+    assert cache.rebuilds==1 and cache.failures==0
+    h=ControllerHistory({k:torch.cat([o[k] for o in observations]) for k in ('obs','bypass')},
+        torch.arange(8),torch.zeros_like(state),torch.stack(goals),True,0)
+    with torch.no_grad():expected=reconstruct_controller_history(model,h,memory_only=True)['reconstructed_state']
+    if write:
+        old_c,_=model.core.split_worker_state(old_state)
