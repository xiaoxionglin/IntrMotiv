+        target.dg_goal_modulation[1, 3:] = 2.
+    state_o = torch.zeros(1, online.total_state_size)
+    state_t = torch.zeros_like(state_o)
+    pre = torch.tensor([[2., 1.5, 2.5]], requires_grad=True)
+    head = torch.cat((torch.relu(pre - 1.), torch.zeros(1, 2), pre), -1)
+    virtual_goal = torch.tensor([[0., 1., 0.]])
