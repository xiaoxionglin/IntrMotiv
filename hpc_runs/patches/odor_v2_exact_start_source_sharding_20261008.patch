@@ -8,0 +9,48 @@
+from sf_working_directories.IntrMotiv.evaluation import submit_place_field_sweep as submitter
+
+
+def test_source_shard_options_preserve_panel_and_validate_ids():
+    intervention = {
+        "evaluation": "landmark-matched-commands-v1",
+        "max_sources": 16,
+        "targets_per_source": 15,
+        "repeats": 3,
+    }
+    assert ev.landmark_options_for_row(intervention, None, 2) == {
+        "max_sources": 16, "targets_per_source": 15, "repeats": 3,
+    }
+    assert ev.landmark_options_for_row(intervention, "4,5,6,7", 8) == {
+        "max_sources": 4, "targets_per_source": 15, "repeats": 3,
+        "focus_sources": [4, 5, 6, 7], "discovery_multiplier": 8,
+    }
+    for invalid in ("", "0,0", "-1,2", "0,a"):
+        with pytest.raises(ValueError):
+            ev.landmark_options_for_row(intervention, invalid, 8)
+    with pytest.raises(ValueError):
+        ev.landmark_options_for_row(intervention, "0,1", 0)
+    with pytest.raises(ValueError):
+        ev.landmark_options_for_row({"evaluation": "other"}, "0,1", 8)
+
+
+def test_source_shard_exports_are_explicit_and_slurm_safe(monkeypatch, tmp_path):
+    monkeypatch.setenv("INTERVENTION_FOCUS_SOURCES", "0,1,2,3")
+    monkeypatch.setenv("INTERVENTION_DISCOVERY_MULTIPLIER", "8")
+    command = submitter.build_sbatch_command(
+        row=submitter.ManifestRow(0, {"label_suffix": "cell"}),
+        manifest=tmp_path / "manifest.tsv", output_dir=tmp_path / "output",
+        runner=tmp_path / "runner.sh", partition="cpu", cpus=4, memory="16G",
+        time_limit="06:00:00", max_num_frames=300000,
+        job_name_prefix="shard", workspace_root=tmp_path,
+    )
+    exported = next(value for value in command if value.startswith("--export="))
+    assert "INTERVENTION_FOCUS_SOURCES=0:1:2:3" in exported
+    assert "INTERVENTION_DISCOVERY_MULTIPLIER=8" in exported
+    monkeypatch.setenv("INTERVENTION_FOCUS_SOURCES", "0,1,broken")
+    with pytest.raises(ValueError, match="Invalid INTERVENTION_FOCUS_SOURCES"):
+        submitter.build_sbatch_command(
+            row=submitter.ManifestRow(0, {"label_suffix": "cell"}),
+            manifest=tmp_path / "manifest.tsv", output_dir=tmp_path / "output",
+            runner=tmp_path / "runner.sh", partition="cpu", cpus=4, memory="16G",
+            time_limit="06:00:00", max_num_frames=300000,
+            job_name_prefix="shard", workspace_root=tmp_path,
+        )
