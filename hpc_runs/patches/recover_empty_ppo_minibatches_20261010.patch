+def has_ppo_minibatch_support(valids: Tensor) -> bool:
+    """PPO's advantage variance requires two valid decisions in this minibatch.
+
+    A batch can pass the generation barrier while fixed, unshuffled minibatches
+    put every fresh rollout in one half. Check each half before forwarding it;
+    the batch-wide valid count does not establish minibatch support.
+    """
+    return int(valids.sum().item()) >= 2
 
 
