@@ -0,0 +1,37 @@
+"""The C01 flat policy reward intervention must leave encoder credit intact."""
+
+import pytest
+import torch
+
+from sf_working_directories.IntrMotiv.dmlab.custom_learner import (
+    flat_policy_reward,
+    legacy_reward_streams,
+)
+
+
+def test_constant_changes_only_flat_policy_reward():
+    distance = torch.tensor([[71.0, 68.0, 64.0, 70.0, 71.0]])
+    temporal_policy, encoder = legacy_reward_streams(
+        distance, 71.0, 0.1, "encourage", "temporal"
+    )
+
+    assert flat_policy_reward(temporal_policy, "temporal", 0.0) is temporal_policy
+    constant_policy = flat_policy_reward(temporal_policy, "constant", 0.4)
+    assert torch.equal(
+        constant_policy,
+        torch.where(temporal_policy.ne(0), torch.full_like(temporal_policy, 0.4), 0.0),
+    )
+    assert torch.equal(constant_policy.eq(0), temporal_policy.eq(0))
+    assert not torch.equal(constant_policy, temporal_policy)
+    assert torch.equal(encoder, distance[:, 1:-1] * 0.1)
+
+
+@pytest.mark.parametrize("constant", [-1.0, float("nan"), float("inf")])
+def test_invalid_constant_is_rejected(constant):
+    with pytest.raises(ValueError, match="finite and nonnegative"):
+        flat_policy_reward(torch.ones(1, 2), "constant", constant)
+
+
+def test_unknown_mode_is_rejected():
+    with pytest.raises(ValueError, match="Unknown flat_policy_reward_mode"):
+        flat_policy_reward(torch.ones(1, 2), "other", 1.0)
