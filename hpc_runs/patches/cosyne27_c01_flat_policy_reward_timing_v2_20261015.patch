+def flat_policy_reward(decoder_reward: Tensor, mode: str, constant: float) -> Tensor:
+    """Replace only the flat policy reward; leave DG encoder credit untouched."""
+    if mode == "temporal":
+        return decoder_reward
+    if mode == "constant":
+        if not math.isfinite(constant) or constant < 0.0:
+            raise ValueError("flat_policy_reward_constant must be finite and nonnegative")
+        # Preserve the original reward-eligible decisions, including exact zeros.
+        return torch.where(decoder_reward.ne(0), torch.full_like(decoder_reward, constant), 0.0)
+    raise ValueError(f"Unknown flat_policy_reward_mode: {mode}")
 
 
