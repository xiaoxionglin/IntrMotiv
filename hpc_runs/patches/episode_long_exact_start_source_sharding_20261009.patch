+def landmark_options_for_row(intervention, focus_sources=None, discovery_multiplier=None):
+    """Keep the declared panel while bounding native-engine lifetimes by source."""
+    if intervention.get("evaluation") != "landmark-matched-commands-v1":
+        if focus_sources is not None or discovery_multiplier is not None:
+            raise ValueError("Source shards require landmark-matched-commands-v1")
+        return None
+    options = {
+        key: intervention[key]
+        for key in (
+            "max_sources", "targets_per_source", "repeats", "discovery_multiplier",
+            "target_selection", "fixed_evaluation_horizon", "horizons",
+        )
+        if key in intervention
+    }
+    if focus_sources is not None:
+        try:
+            source_ids = [int(value) for value in focus_sources.split(",")]
+        except ValueError as exc:
+            raise ValueError("Source IDs must be comma-separated integers") from exc
+        if not source_ids or len(source_ids) != len(set(source_ids)) or any(source < 0 for source in source_ids):
+            raise ValueError("Source IDs must be distinct nonnegative integers")
+        if len(source_ids) > int(options.get("max_sources", len(source_ids))):
+            raise ValueError("Source shard exceeds declared max_sources")
+        options.update(max_sources=len(source_ids), focus_sources=source_ids)
+    if discovery_multiplier is not None:
+        if discovery_multiplier <= 0:
+            raise ValueError("Discovery multiplier must be positive")
+        options["discovery_multiplier"] = discovery_multiplier
+    return options
+
