--- a/sf_working_directories/IntrMotiv/tests/test_landmark_matched_interventions.py
+++ b/sf_working_directories/IntrMotiv/tests/test_landmark_matched_interventions.py
@@ -6,6 +6,25 @@
 from torch import nn
 
 from sf_working_directories.IntrMotiv.evaluation import target_control_interventions as ev
+
+
+def test_source_shard_options_preserve_declared_panel():
+    intervention = {
+        "evaluation": "landmark-matched-commands-v1", "max_sources": 4,
+        "targets_per_source": 3, "repeats": 8, "horizons": [64, 128, 256, 900],
+        "fixed_evaluation_horizon": 900, "target_selection": "all_eligible",
+    }
+    whole = ev.landmark_options_for_row(intervention)
+    assert whole["max_sources"] == 4 and "focus_sources" not in whole
+    shard = ev.landmark_options_for_row(intervention, "2", 8)
+    assert shard == {**whole, "max_sources": 1, "focus_sources": [2],
+                     "discovery_multiplier": 8}
+    assert whole["max_sources"] == 4  # no mutation of the declared settings
+    for bad in ("", "0,0", "-1", "0,a"):
+        with pytest.raises(ValueError):
+            ev.landmark_options_for_row(intervention, bad, 8)
+    with pytest.raises(ValueError):
+        ev.landmark_options_for_row({"evaluation": "other"}, "0", 8)
 
 
