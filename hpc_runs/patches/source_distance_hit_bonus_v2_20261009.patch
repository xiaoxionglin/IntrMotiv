+def source_dg_distance(prior_progression: Tensor, source: Tensor, baseline: int) -> Tensor:
+    """Age since the option's source DG event strictly before each hit transition.
+
+    An absent source or one outside CA3's trace window receives the baseline,
+    so it contributes no temporal hit bonus. Other DG events cannot refresh it.
+    """
+    if prior_progression.ndim != 3 or source.shape != prior_progression.shape[:2]:
+        raise ValueError("Source IDs must align with DG progression transitions")
+    valid_source = (source >= 0) & (source < prior_progression.size(-1))
+    previous_age = prior_progression.gather(
+        -1, source.clamp(0, prior_progression.size(-1) - 1).long().unsqueeze(-1)
+    ).squeeze(-1)
+    age = (previous_age + 1).clamp_max(int(baseline))
+    return torch.where(valid_source, age, torch.full_like(age, int(baseline))).float()
+
