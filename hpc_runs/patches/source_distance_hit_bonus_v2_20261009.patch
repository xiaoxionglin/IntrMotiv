+    def test_source_hit_bonus_ignores_intervening_dg_and_keeps_hit_gate(self):
+        # At the first hit another DG is much newer than the command source.
+        # Progression is read before the hit, so simultaneous source activation
+        # on the hit transition cannot masquerade as a preceding source event.
+        progression = torch.tensor([[[49, 2, 0], [71, 1, 0]]])
+        source = torch.tensor([[0, 0]])
+        source_age = source_dg_distance(progression, source, baseline=71)
+        self.assertTrue(torch.equal(source_age, torch.tensor([[50.0, 71.0]])))
+        internal = torch.tensor([[71.0, 71.0, 2.0, 1.0]])
+        hit = torch.tensor([[0.0, 0.0, 1.0, 0.0]])
+        nearest_reward = target_success_worker_reward(internal, hit, 71, 0.1, "hit_distance", 1.0, 0.1)
+        source_reward = target_success_worker_reward(
+            internal, hit, 71, 0.1, "hit_distance", 1.0, 0.1, distance_override=source_age
+        )
+        self.assertTrue(torch.allclose(nearest_reward, torch.tensor([[1.69, 0.0]])))
+        self.assertTrue(torch.allclose(source_reward, torch.tensor([[1.21, 0.0]])))
