+def worker_value_dones(physical_dones: Tensor, goal_hits: Tensor | None, mode: str) -> Tensor:
+    """Stop worker GAE at a goal hit while leaving physical episode state intact."""
+    if mode == "episode":
+        return physical_dones
+    if mode != "goal_hit":
+        raise ValueError(f"Unknown HRL value termination mode: {mode}")
+    if goal_hits is None or goal_hits.shape != physical_dones.shape:
+        raise ValueError("Goal-hit value boundaries must align with rollout transitions")
+    return (physical_dones.bool() | goal_hits.bool()).to(dtype=physical_dones.dtype)
 
 
