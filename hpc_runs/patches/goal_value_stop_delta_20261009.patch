+    def test_goal_hit_terminates_worker_value_only(self):
+        from sample_factory.algo.utils.rl_utils import gae_advantages
+
+        rewards = torch.tensor([[0.0, 1.0, 5.0]])
+        values = torch.zeros((1, 4))
+        valids = torch.ones((1, 4))
+        physical_dones = torch.zeros((1, 3))
+        hits = torch.tensor([[0.0, 1.0, 0.0]])
+        continuing = worker_value_dones(physical_dones, hits, "episode")
+        option_terminal = worker_value_dones(physical_dones, hits, "goal_hit")
+        self.assertIs(continuing, physical_dones)
+        self.assertEqual(option_terminal.tolist(), [[0.0, 1.0, 0.0]])
+        self.assertEqual(physical_dones.tolist(), [[0.0, 0.0, 0.0]])
+        self.assertTrue(torch.equal(
+            gae_advantages(rewards, continuing, values, valids, 1.0, 1.0),
+            torch.tensor([[6.0, 6.0, 5.0]]),
+        ))
+        self.assertTrue(torch.equal(
+            gae_advantages(rewards, option_terminal, values, valids, 1.0, 1.0),
+            torch.tensor([[1.0, 1.0, 5.0]]),
+        ))
+        no_hits = torch.zeros_like(hits)
+        self.assertTrue(torch.equal(worker_value_dones(physical_dones, no_hits, "goal_hit"), physical_dones))
+        # A rollout cutoff without a hit still bootstraps the same command.
+        tail_values = torch.tensor([[0.0, 0.0, 0.0, 7.0]])
+        self.assertTrue(torch.equal(
+            gae_advantages(torch.zeros_like(rewards), worker_value_dones(physical_dones, no_hits, "goal_hit"),
+                           tail_values, valids, 1.0, 1.0),
+            torch.tensor([[7.0, 7.0, 7.0]]),
+        ))
+        tail_hit = torch.tensor([[0.0, 0.0, 1.0]])
+        self.assertTrue(torch.equal(
+            gae_advantages(rewards, worker_value_dones(physical_dones, tail_hit, "goal_hit"),
+                           tail_values, valids, 1.0, 1.0),
+            torch.tensor([[6.0, 6.0, 5.0]]),
+        ))
+        episode_end = torch.tensor([[0.0, 0.0, 1.0]])
+        self.assertEqual(worker_value_dones(episode_end, hits, "goal_hit").tolist(), [[0.0, 1.0, 1.0]])
