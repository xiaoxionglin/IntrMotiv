+def landmark_options_for_row(intervention: dict, focus_sources: str | None,
+                             discovery_multiplier: int) -> dict | None:
+    """Preserve declared trial settings while limiting source discovery."""
+    if intervention.get("evaluation") != "landmark-matched-commands-v1":
+        if focus_sources is not None:
+            raise ValueError("Source shards require landmark-matched-commands-v1")
+        return None
+    options = {
+        key: intervention[key]
+        for key in (
+            "max_sources", "targets_per_source", "repeats",
+            "discovery_multiplier", "target_selection",
+            "fixed_evaluation_horizon", "horizons",
+        )
+        if key in intervention
+    }
+    if focus_sources is None:
+        return options
+    try:
+        source_ids = [int(value) for value in focus_sources.split(",")]
+    except ValueError as exc:
+        raise ValueError("Focus sources must be comma-separated DG IDs") from exc
+    if not source_ids or len(source_ids) != len(set(source_ids)) or any(source < 0 for source in source_ids):
+        raise ValueError("Focus sources must be distinct nonnegative DG IDs")
+    if discovery_multiplier <= 0:
+        raise ValueError("Discovery multiplier must be positive")
+    if "max_sources" in options and len(source_ids) > int(options["max_sources"]):
+        raise ValueError("Source shard exceeds StudySpec max_sources")
+    options.update(max_sources=len(source_ids), focus_sources=source_ids,
+                   discovery_multiplier=discovery_multiplier)
+    return options
+
