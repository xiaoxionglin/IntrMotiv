+def test_source_shard_preserves_declared_panel_and_validates_ids():
+    intervention = {
+        "evaluation": "landmark-matched-commands-v1",
+        "max_sources": 16, "targets_per_source": 3, "repeats": 8,
+        "discovery_multiplier": 10, "target_selection": "all_eligible",
+        "fixed_evaluation_horizon": 900, "horizons": [64, 128, 256, 900],
+    }
+    assert ev.landmark_options_for_row(intervention, None, 8) == {
+        key: value for key, value in intervention.items() if key != "evaluation"
+    }
+    shard = ev.landmark_options_for_row(intervention, "0,2", 8)
+    assert shard["focus_sources"] == [0, 2]
+    assert shard["max_sources"] == 2
+    assert shard["discovery_multiplier"] == 8
+    assert shard["fixed_evaluation_horizon"] == 900
+    assert shard["targets_per_source"] == 3
+    assert shard["repeats"] == 8
+    for invalid in ("", "0,0", "-1,2", "0,a"):
+        with pytest.raises(ValueError):
+            ev.landmark_options_for_row(intervention, invalid, 8)
+
