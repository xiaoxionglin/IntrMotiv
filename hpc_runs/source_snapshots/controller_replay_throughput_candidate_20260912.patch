+"""Indexed physical inputs using Sample Factory's tensor-buffer primitives.
+
+This derived CPU store contains no learned representations. Checkpoints retain
+PhysicalReplay's existing owned-row contract; restore rebuilds this index lazily.
+"""
+from collections import OrderedDict
+
+import numpy as np
+import torch
+from sample_factory.algo.utils.shared_buffers import init_tensor
+from sample_factory.algo.utils.tensor_dict import TensorDict, tensor_dict_to_numpy
+
+
+class PhysicalTensorStore:
+    def __init__(self, capacity, example):
+        self.capacity = capacity
+        fields = dict(observation=example.observation, condition=example.condition,
+                      context=example.context)
+
+        def allocate(value):
+            if isinstance(value, dict):
+                return TensorDict({key: allocate(item) for key, item in value.items()})
+            array = np.asarray(value)
+            return init_tensor([capacity], array.dtype, array.shape, torch.device('cpu'), False)
+
+        self.tensors = allocate(fields)
+        self.arrays = tensor_dict_to_numpy(self.tensors)
+        self.slots = {}
+        self.owners = [None] * capacity
+        self.position = 0
+
+    def add(self, row):
+        slot = self.position
+        previous = self.owners[slot]
+        if previous is not None:
+            del self.slots[previous.key]
+        for key, value in row.observation.items():
+            self.arrays['observation'][key][slot] = value
+        self.arrays['condition'][slot] = row.condition
+        self.arrays['context'][slot] = row.context
+        self.owners[slot] = row
+        self.slots[row.key] = slot
+        self.position = (slot + 1) % self.capacity
+
+    def gather(self, rows, device, include_observations=True):
+        slots = []
+        missing = []
+        for index, row in enumerate(rows):
+            slot = self.slots.get(row.key)
+            owner = self.owners[slot] if slot is not None else None
+            # Synthetic certified terminal successors and evicted held rows must
+            # never alias a different physical row at a recycled ring position.
+            if (owner is None or owner.observation is not row.observation
+                    or owner.condition is not row.condition or owner.context is not row.context):
+                missing.append((index, row))
+                slot = 0
+            slots.append(slot)
+        source = self.tensors if include_observations else TensorDict(
+            condition=self.tensors['condition'], context=self.tensors['context'])
+        batch = source[torch.tensor(slots, dtype=torch.long)]
+        for index, row in missing:
+            values = TensorDict(condition=row.condition, context=row.context)
+            if include_observations:values['observation'] = row.observation
+            batch[index] = values
+
+        def move(value):
+            if isinstance(value, dict):
+                return TensorDict({key: move(item) for key, item in value.items()})
+            return value.to(device)
+
+        return move(batch)
+
+
+class ReplayTensorBatch:
+    """Share raw input gathers across online/target calls in one evaluation.
+
+    Two entries retain current-label screening plus its accepted history batch.
+    No model output or normalization result is cached across snapshots.
+    """
+    def __init__(self, replay, device, include_observations=True):
+        self.include_observations = include_observations
+        self.replay = replay
+        self.device = device
+        self.cache = OrderedDict()
+
+    def __call__(self, rows):
+        key = tuple(id(row) for row in rows)
+        if key not in self.cache:
+            self.cache[key] = self.replay.tensor_rows(rows, self.device, self.include_observations)
+            while len(self.cache) > 2:
+                self.cache.popitem(last=False)
+        self.cache.move_to_end(key)
+        return self.cache[key]
