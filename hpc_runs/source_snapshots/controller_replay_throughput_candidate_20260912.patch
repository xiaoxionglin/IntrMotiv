+def test_raw_gather_cache_is_shared_but_not_checkpointed():
+    replay=PhysicalReplay(8,8)
+    for i in range(4):replay.receive(row(i))
+    rows=list(replay.rows.values())
+    pack=ReplayTensorBatch(replay,'cpu')
+    with patch.object(replay,'tensor_rows',wraps=replay.tensor_rows) as gather:
+        first=pack(rows);assert pack(rows) is first
+        assert gather.call_count==1
+    state=replay.state_dict()
+    assert '_tensor_store' not in state
+    restored=PhysicalReplay(8,8);restored.load_state_dict(state)
+    assert restored._tensor_store is None
+    other=restored.tensor_rows(list(restored.rows.values()),'cpu')
+    assert torch.equal(first['observation']['obs'],other['observation']['obs'])
+    assert restored.session==1
+    assert restored.rejected['restart_pending_tail']==1
+
