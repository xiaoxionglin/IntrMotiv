+@pytest.mark.parametrize('write',[False,True])
+@pytest.mark.parametrize('screen',[False,True])
+def test_tensor_path_matches_rewards_labels_q_and_gradients(write,screen):
+    model=RewardModel(write).eval();other=deepcopy(model)
+    physical,_=physical_rows(model)
+    replay=PhysicalReplay(10,99)
+    for item in physical:replay.receive(item)
+    # Last physical observation is still ingress pending: gathering must also
+    # handle that external row without reading an unrelated ring slot.
+    rows=list(replay.rows.values())+[physical[-1]]
+    main=TransitionInput(tuple(rows[:2]),0)
+    examples=[main,replace(main,virtual_goal=1,remaining=3),TransitionInput(tuple(rows),1)]
+    expected=transition_values_batch(other,examples,screen_current=screen)
+    actual=transition_values_batch(model,examples,screen_current=screen,
+                                  pack_rows=ReplayTensorBatch(replay,'cpu'))
+    for a,b in zip(actual,expected):
+        assert type(a) is type(b)
+        if isinstance(a,str):assert a==b;continue
+        assert a['done']==b['done']
+        for key in ('q','reward','signature','canonical','next_canonical'):
+            assert torch.equal(a[key],b[key]),key
+    sum(item['q'].sum() for item in actual if not isinstance(item,str)).backward()
+    sum(item['q'].sum() for item in expected if not isinstance(item,str)).backward()
+    for a,b in zip(model.parameters(),other.parameters()):
+        assert (a.grad is None)==(b.grad is None)
+        if a.grad is not None:assert torch.equal(a.grad,b.grad)
