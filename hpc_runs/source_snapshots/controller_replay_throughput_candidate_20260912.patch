+"""Snapshot-local reuse of encoder outputs when STOP freezes the entire head.
+
+Lifetime is one fresh-DG/controller transaction. Online and target entries are
+separate, and a target refresh explicitly drops its entries. No learned output
+is reused across a fresh DG update, serialized, or shared with actors.
+"""
+import numpy as np
+import torch
+from .controller_history import reconstruction_head
+
+
+class SnapshotHeadCache:
+    def __init__(self, replay, device):
+        self.replay = replay
+        self.device = device
+        self.rows = list(replay.rows.values())
+        self.indices = {id(row.observation): i for i, row in enumerate(self.rows)}
+        self.snapshots = {}
+
+    def invalidate(self, model):
+        self.snapshots.pop(id(model), None)
+
+    def __call__(self, model, rows):
+        if model.training or any(p.requires_grad for p in model.encoder.parameters()):
+            raise RuntimeError('Head reuse requires an evaluation snapshot with a frozen encoder')
+        key = id(model)
+        if key not in self.snapshots:
+            self.snapshots[key] = [np.zeros(len(self.rows), dtype=bool), None]
+        valid, table = self.snapshots[key]
+        indices = np.fromiter((self.indices.get(id(row.observation), -1) for row in rows),
+                              dtype=np.int64, count=len(rows))
+        physical = indices[indices >= 0]
+        missing = np.unique(physical[~valid[physical]])
+        external_positions = np.flatnonzero(indices < 0)
+        encode_rows = [self.rows[int(i)] for i in missing]
+        encode_rows.extend(rows[int(i)] for i in external_positions)
+        encoded = None
+        if encode_rows:
+            inputs = self.replay.tensor_rows(encode_rows, self.device)['observation']
+            encoded = reconstruction_head(model, inputs)
+            if encoded.requires_grad:
+                raise RuntimeError('Head reuse would discard an encoder gradient')
+            if table is None:
+                table = encoded.new_empty((len(self.rows), encoded.shape[-1]))
+                self.snapshots[key][1] = table
+            if len(missing):
+                table[torch.as_tensor(missing, device=self.device)] = encoded[:len(missing)]
+                valid[missing] = True
+        result = table[torch.as_tensor(indices.clip(min=0), device=self.device)]
+        if len(external_positions):
+            result[torch.as_tensor(external_positions, device=self.device)] = encoded[len(missing):]
+        return result
