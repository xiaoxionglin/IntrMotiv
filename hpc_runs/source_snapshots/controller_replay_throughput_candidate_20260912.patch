+def replay_successor_events(core, hrl, next_dg, previous_core, recorded):
+    """Rebuild reward events without running a new manager policy in replay.
+
+    Recorded successor context supplies the actual next command. Only the
+    outcome fields consumed by event validation and worker rewards are replaced.
+    Motion-filtered and non-topological parents retain their original path.
+    """
+    if not event_only_replay_supported(core):
+        return core._update_hrl(hrl, next_dg, previous_core)[0]
+    from .topological_frontier import option_outcome_masks, MODE_EXPLORE, decode_node
+    n = core.Hippo_n_feature
+    layout = HRLStateLayout(n); topo_layout = TopologicalStateLayout(n)
+    option_size = hrl_option_state_size(n)
+    option = hrl[:, :option_size].clone()
+    topo = hrl[:, option_size:].clone()
+    generation = core.policy_graph.representation_generation.to(option)
+    has_option = (option[:, layout.target] > 0) | (option[:, layout.source] > 0)
+    stale = has_option & (option[:, layout.persistent_start] != generation)
+    option[stale, :layout.persistent_start] = 0
+    topo[stale] = 0
+    current, active, count = current_dg_from_activity(next_dg)
+    exclusive = active & (count == 1)
+    last = decode_node(topo[:, topo_layout.last_landmark])
+    elapsed_passive = topo[:, topo_layout.last_landmark_age] + 1.0
+    passive = (exclusive & (last >= 0) & (last != current) & (elapsed_passive > 0)
+        & (elapsed_passive <= float(getattr(core.cfg, 'hrl_passive_max_path_length', core.L))))
+    target, source, mode, hit, wrong, expired, elapsed = option_outcome_masks(
+        option, topo, current, exclusive, n_nodes=n, control_outcome=core.hrl_control_outcome)
+    interrupted = ((mode == MODE_EXPLORE) & passive
+        & bool(getattr(core.cfg, 'hrl_edge_exploration', False)))
+    hit = hit & ~interrupted
+    wrong = wrong & ~interrupted & ~hit
+    expired = expired & ~interrupted & ~hit & ~wrong
+    result = recorded.clone()
+    result[:, layout.active_dg] = (current + 1).to(result.dtype)
+    result[:, layout.multi_activation] = (count > 1).to(result.dtype)
+    result[:, layout.target_hit] = hit.to(result.dtype)
+    result[:, layout.option_expired] = (wrong | expired).to(result.dtype)
+    negative = wrong | (expired & (mode == MODE_EXPLORE))
+    result[:, layout.completion_elapsed] = torch.where(
+        hit | wrong | expired, torch.where(negative, -elapsed, elapsed), 0.0)
+    return result
