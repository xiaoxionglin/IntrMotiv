+def test_tensor_gather_order_dtype_eviction_and_terminal_override():
+    replay=PhysicalReplay(2,99)
+    for i in (1,0,2):replay.receive(row(i))
+    old=list(replay.rows.values())
+    packed=replay.tensor_rows([old[1],old[0],old[1]],'cpu')
+    assert isinstance(packed,TensorDict)
+    assert packed['observation']['obs'].dtype==torch.uint8
+    assert packed['observation']['obs'].flatten().tolist()==[1,0,1]
+    replay.receive(row(3));replay.receive(row(4))
+    newest=list(replay.rows.values())[-1]
+    terminal=replace(newest,observation={'obs':np.array([99],np.uint8)})
+    packed=replay.tensor_rows([old[0],newest,terminal],'cpu')
+    assert packed['observation']['obs'].flatten().tolist()==[0,3,99]
+    assert newest.observation['obs'][0]==3
+    np.testing.assert_array_equal(packed['context'].numpy(),np.stack([old[0].context,newest.context,terminal.context]))
+
