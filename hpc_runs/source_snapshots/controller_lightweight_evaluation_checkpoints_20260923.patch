-        super().save_milestone()
+        # Milestones are evaluation artifacts, not restart points. Keeping the
+        # full physical replay in every milestone multiplies a mature stored-
+        # state checkpoint by several GiB without helping evaluation.
+        self._evaluation_checkpoint = True
+        try:
+            super().save_milestone()
+        finally:
+            self._evaluation_checkpoint = False
         directory = Path(self.checkpoint_dir(self.cfg, self.policy_id)) / "milestones"
         files = [Path(path) for path in self.get_checkpoints(str(directory)) if Path(path).suffix == ".pth"]
         keep = max(1, int(self.cfg.keep_checkpoints))
         retained = {path.name for path in files[-keep:]} | self.frame_milestones
         for path in files:
             if path.name not in retained:
                 path.unlink()
+
+    def save_best(self, policy_id, metric, metric_value):
+        # Best checkpoints serve model selection and evaluation. Exact training
+        # continuation always uses the recent rolling restart checkpoint.
+        self._evaluation_checkpoint = True
+        try:
+            return super().save_best(policy_id, metric, metric_value)
+        finally:
